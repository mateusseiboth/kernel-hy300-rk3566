&{/adc-keys} {
	io-channels = <&{/saradc@fe720000} 0x1>;
	status = "okay";
};
&{/adc-keys} {
	back-key {
		label = "back";
		linux,code = <0x9e>;
		press-threshold-microvolt = <0x1f4>;
	};
};
&{/adc-keys} {
	down-key {
		label = "down";
		linux,code = <0x6c>;
		press-threshold-microvolt = <0x3d4>;
	};
};
&{/adc-keys} {
	left-key {
		label = "left";
		linux,code = <0x69>;
		press-threshold-microvolt = <0x140>;
	};
};
&{/adc-keys} {
	ok-key {
		label = "ok";
		linux,code = <0x1c>;
		press-threshold-microvolt = <0xa0>;
	};
};
&{/adc-keys} {
	right-key {
		label = "right";
		linux,code = <0x6a>;
		press-threshold-microvolt = <0x28>;
	};
};
&{/adc-keys} {
	up-key {
		label = "up";
		linux,code = <0x67>;
		press-threshold-microvolt = <0x541>;
	};
};
