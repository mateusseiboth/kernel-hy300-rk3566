# Projetor HY300 (RK3566, ROM TXCZ). Fragmento sobre o defconfig Linux do BSP:
#
#   make ARCH=arm64 rockchip_linux_defconfig rk3566.config rk3566_hy300.config
#
# Marco 1: primeiro boot do 6.1 pela partição recovery, com initramfs de teste e log
# lido depois pelo kernel de fábrica em /sys/fs/pstore/console-ramoops-0.

CONFIG_LOCALVERSION="-hy300"
# CONFIG_LOCALVERSION_AUTO is not set

# Toolchain mais nova que a do BSP: avisos novos não podem parar o build.
# CONFIG_WERROR is not set
CONFIG_DEBUG_INFO_NONE=y

# DTB com __symbols__: o U-Boot aplica o overlay da recovery_dtbo por cima.
CONFIG_DTC_SYMBOLS=y

# initramfs vem na seção ramdisk do boot.img (gzip, como o de fábrica).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Log persistente: mesmo layout do ramoops de fábrica (DT), console incluso.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_BOOT_LOG is not set

# kexec para os próximos marcos (trocar de kernel sem regravar a recovery).
CONFIG_KEXEC=y

# Qualquer travamento detectável vira panic, e panic vira reboot quente em 10 s
# (o U-Boot volta para o Android de fábrica com a RAM preservada).
CONFIG_PANIC_TIMEOUT=10
CONFIG_PANIC_ON_OOPS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

# Placa: teclas, controle IR, LEDs/ventoinha, eMMC, painel.
CONFIG_KEYBOARD_ADC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_ROCKCHIP_REMOTECTL=y
CONFIG_ROCKCHIP_REMOTECTL_PWM=y
CONFIG_LEDS_GPIO=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_LVDS=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_PWM=y

# Primeiro boot com o mínimo de risco: sem DVFS (CPU, DDR e barramentos ficam como o
# U-Boot deixou), sem GPU e sem NPU. Voltam nos próximos marcos.
# CONFIG_CPU_FREQ is not set
# CONFIG_ARM_ROCKCHIP_DMC_DEVFREQ is not set
# CONFIG_ARM_ROCKCHIP_BUS_DEVFREQ is not set
# CONFIG_MALI_BIFROST is not set
# CONFIG_ROCKCHIP_RKNPU is not set

# Testes de boot sem serial: ventoinha liga e watchdog arma no começo do setup_arch.
# O watchdog core não alimenta o watchdog armado cedo: um travamento termina em reset.
CONFIG_HY300_EARLY_BEACON=y
# CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED is not set
# O U-Boot de fábrica recebe o DT de fábrica; o kernel usa o próprio (rk3566-hy300).
CONFIG_HY300_BUILTIN_DTB=y

# Console no framebuffer: o log do kernel aparece na tela do projetor (sem serial).
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Wi-Fi AIC8800D80 por SDIO, como módulo: o /init de teste só carrega com hy300.wifi=1.
CONFIG_AIC8800=m

# Recuperação (Alpine na partição recovery): o rootfs vem em squashfs (xz, já ligado) dentro do
# initramfs e ganha uma camada gravável em tmpfs. f2fs e erofs leem/gravam as partições do
# Android (userdata, metadata, system/vendor novos), exfat é o pendrive comum na USB-A.
CONFIG_OVERLAY_FS=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_EXFAT_FS=y

# Device mapper: mapear as partições lógicas da super (dm-linear, como o init do Android faz)
# para ler, montar ou fazer backup de system/vendor/product de dentro da recuperação.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
