# Projetor HY300 (RK3566, ROM TXCZ). Fragmento sobre o defconfig Android da Rockchip e os
# requisitos do Android 14 (FCM 8, o único que aceita o 6.1 no Android 17), com clang:
#
#   make ARCH=arm64 LLVM=1 LLVM_IAS=1 rockchip_defconfig android-14.config rk3566_hy300.config
#
# Marco 1: primeiro boot do 6.1 pela partição recovery, com initramfs de teste e log
# lido depois pelo kernel de fábrica em /sys/fs/pstore/console-ramoops-0.

CONFIG_LOCALVERSION="-hy300"
# CONFIG_LOCALVERSION_AUTO is not set

# Toolchain mais nova que a do BSP: avisos novos não podem parar o build.
# CONFIG_WERROR is not set
CONFIG_DEBUG_INFO_NONE=y

# DTB com __symbols__: o U-Boot aplica o overlay da recovery_dtbo por cima.
CONFIG_DTC_SYMBOLS=y

# initramfs vem na seção ramdisk do boot.img (gzip, como o de fábrica).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Log persistente: mesmo layout do ramoops de fábrica (DT), console incluso.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_BOOT_LOG is not set

# kexec para os próximos marcos (trocar de kernel sem regravar a recovery).
CONFIG_KEXEC=y

# Qualquer travamento detectável vira panic, e panic vira reboot quente em 5 s (o pstore
# guarda o log e o próximo boot decide o que subir). Não depende de panic= na cmdline.
CONFIG_PANIC_TIMEOUT=5
CONFIG_PANIC_ON_OOPS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
# Hung task: tarefa em D por 120 s (o padrão do ACK, 10 s, reiniciaria em qualquer E/S lenta).
# Espera longa de escrita em pendrive lento não conta: o throttle dorme em fatias curtas.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
# Travamento duro (CPU presa com IRQs desligadas): o ACK traz o detector "buddy"
# (HARDLOCKUP_DETECTOR_OTHER_CPU), em que cada CPU vigia a vizinha pelo hrtimer; não
# precisa de NMI. O detector por perf/NMI do arm64 só chegou no 6.4. O pseudo-NMI
# (ARM64_PSEUDO_NMI, já ligado) fica para a cmdline (irqchip.gicv3_pseudo_nmi=1) e não é
# padrão: muda a máscara de prioridades do GIC no caminho de toda interrupção e ninguém
# testou com o TF-A de fábrica. Sem ele o panic ainda reinicia: o PSCI SYSTEM_RESET não
# depende da CPU presa.
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y

# Watchdog do SoC: último recurso, quando nenhuma CPU consegue reiniciar. O núcleo do
# watchdog alimenta o dw-wdt (armado cedo pelo HY300_EARLY_BEACON) até alguém abrir o
# /dev/watchdog, então só um travamento do kernel o deixa estourar. O primeiro estouro é
# o pré-timeout: panic e reinício normal, com o log no pstore. O segundo é o reset de
# hardware, que com o HY300_WDT_REBOOT reinicia em vez de desligar.
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV=y
CONFIG_WATCHDOG_PRETIMEOUT_GOV_PANIC=y
CONFIG_WATCHDOG_PRETIMEOUT_DEFAULT_GOV_PANIC=y
CONFIG_DW_WATCHDOG_PRETIMEOUT_DEFAULT=y
CONFIG_HY300_WDT_REBOOT=y
# Teste dos caminhos acima no aparelho (só por escrita no debugfs, como root):
# echo HARDLOCKUP > /sys/kernel/debug/provoke-crash/DIRECT trava uma CPU com IRQs
# desligadas; SOFTLOCKUP e HUNGTASK testam os outros detectores.
CONFIG_LKDTM=y

# Placa: teclas, controle IR, LEDs/ventoinha, eMMC, painel.
CONFIG_KEYBOARD_ADC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_ROCKCHIP_REMOTECTL=y
CONFIG_ROCKCHIP_REMOTECTL_PWM=y
CONFIG_LEDS_GPIO=y
CONFIG_REGULATOR_GPIO=y
CONFIG_REGULATOR_PWM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_LVDS=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_PWM=y

# DVFS. CPU pelo rockchip-cpufreq (sobre o cpufreq-dt): tabela do BSP até 1,8 GHz, a mesma
# frequência máxima da fábrica, com as tensões do vdd_cpu (PWM) escolhidas pelo PVTM do OTP.
# Este chip (pvtm 89400) cai na faixa L2 do BSP e na L1 da fábrica: o BSP dá 25 mV a mais em
# cada frequência (1,075 V em 1,8 GHz contra 1,05 V); o teto da tabela é 1,15 V. Governador padrão schedutil, performance disponível. DDR pelo rockchip_dmc com o
# TF-A de fábrica (V1.02), como no Android de fábrica: 780 MHz normal e 528 MHz no reboot.
# GPU pelo devfreq do Panfrost (ver o DT). Throttling pela soc-thermal: 75 e 85 °C
# (power allocator sobre CPU e GPU), desligamento em 115 °C.
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_ROCKCHIP_DMC_DEVFREQ=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_THERMAL=y
CONFIG_CPU_THERMAL=y
# Barramentos e NPU continuam fora; a GPU é o Panfrost, não o kbase.
# CONFIG_ARM_ROCKCHIP_BUS_DEVFREQ is not set
# CONFIG_MALI_BIFROST is not set
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI400 is not set
# CONFIG_ROCKCHIP_RKNPU is not set

# Testes de boot sem serial: ventoinha liga e watchdog arma no começo do setup_arch
# (cerca de 89 s, cobre um travamento antes do driver dw_wdt subir).
CONFIG_HY300_EARLY_BEACON=y
# O U-Boot de fábrica recebe o DT de fábrica; o kernel usa o próprio (rk3566-hy300).
CONFIG_HY300_BUILTIN_DTB=y

# Console no framebuffer: o log do kernel aparece na tela do projetor (sem serial).
# O fbcon depende do VT, que o rockchip_defconfig desliga.
CONFIG_VT=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Wi-Fi AIC8800D80 por SDIO, como módulo: o /init de teste só carrega com hy300.wifi=1.
CONFIG_AIC8800=m

# Recuperação (Alpine na partição recovery): o rootfs vem em squashfs (xz, já ligado) dentro do
# initramfs e ganha uma camada gravável em tmpfs. f2fs e erofs leem/gravam as partições do
# Android (userdata, metadata, system/vendor novos), exfat é o pendrive comum na USB-A.
CONFIG_OVERLAY_FS=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_EXFAT_FS=y

# Device mapper: mapear as partições lógicas da super (dm-linear, como o init do Android faz)
# para ler, montar ou fazer backup de system/vendor/product de dentro da recuperação.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y

# kexec_file_load (kexec -s) além do kexec_load: a recuperação boota kernels de teste
# (LineageOS) sem regravar partição.
CONFIG_KEXEC_FILE=y

# Adaptadores Ethernet USB (ASIX, AX88179, CDC/NCM; o RTL8152 já vem do defconfig): rede
# cabeada com DHCP na recuperação quando o Wi-Fi não sobe. Embutidos porque a recuperação
# não carrega módulos por hotplug.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

# GPU Mali-G52 pelo Panfrost (Mesa), como módulo: só carrega quando o teste de GPU da
# recuperação pede (modprobe panfrost), então um problema na GPU não derruba o boot.
CONFIG_DRM_PANFROST=m

# Fonte Terminus 16x32 para o fbcon (fbcon=font:TER16x32 na cmdline): o texto projetado
# fica legível a distância. As fontes padrão continuam disponíveis.
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Motor de passo do foco (/sys/class/motor_cc/motor_cc, a interface do kernel de fábrica).
# Embutido: o app de configurações e o controle remoto contam com ele desde o boot.
CONFIG_HY300_FOCUS_MOTOR=y
